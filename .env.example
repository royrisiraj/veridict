# Offline checks are the default; fixture launchers always work without network.
LIVE_CHECKS=false
DATABASE_PATH=runtime/veridict.db
CHAIN_MODE=auto
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYMENT_PATH=runtime/deployment.json
# Local development account only. Compose uses Hardhat's unlocked local signer.
CHAIN_PRIVATE_KEY=
OPENPHISH_CACHE_PATH=runtime/openphish.txt
OPENPHISH_CACHE_MAX_AGE=86400
GOOGLE_SAFE_BROWSING_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
BACKEND_URL=http://127.0.0.1:8000
# Preferred server-side proxy setting; use the deployed backend HTTPS origin on Vercel.
BACKEND_BASE_URL=http://127.0.0.1:8000
# Native preserves SQLite/live checks; Vercel automatically selects serverless.
RUNTIME_MODE=native
# Optional expected public EVM network ID (required for CHAIN_MODE=public_chain).
CHAIN_ID=
# Optional Vercel backend Deployment Protection automation bypass, server-side only.
BACKEND_PROTECTION_BYPASS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
