# Copy to .env.local and set the real backend origin. No NEXT_PUBLIC_ secrets.
BACKEND_BASE_URL=https://your-veridict-api.vercel.app
# Optional, only if the backend uses Vercel Deployment Protection.
BACKEND_PROTECTION_BYPASS=
# Same random server-to-server value as backend SCAN_API_SECRET; never NEXT_PUBLIC_.
SCAN_API_SECRET=
