          },
          "mode": {
            "enum": [
              "fixture",
              "live",
              "local"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "const": "redirect",
            "default": "redirect",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "mode",
          "data"
        ],
        "title": "RedirectEvidence",
        "type": "object"
      },
      "RiskClass": {
        "enum": [
          "LOW_RISK",
          "SUSPICIOUS",
          "HIGH_RISK",
          "CONFIRMED_MALICIOUS",
          "INCONCLUSIVE"
        ],
        "title": "RiskClass",
        "type": "string"
      },
      "SocialIndicator": {
