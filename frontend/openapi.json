          "status",
          "mode",
          "data"
        ],
        "title": "TLSEvidence",
        "type": "object"
      },
      "TamperRequest": {
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Id"
          },
          "mutation": {
            "enum": [
              "tls_cert",
              "drop_threat_intel",
              "alter_redirect",
              "unground_ai_claim"
            ],
            "title": "Mutation",
            "type": "string"
          }
        },
        "required": [
          "mutation"
        ],
        "title": "TamperRequest",
        "type": "object"
      },
      "TamperResponse": {
        "additionalProperties": false,
        "properties": {
          "computed_root": {
            "pattern": "^0x[0-9a-f]{64}$",
