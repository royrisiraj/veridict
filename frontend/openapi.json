{
  "components": {
    "schemas": {
      "ChainReceipt": {
        "additionalProperties": false,
        "properties": {
          "block_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block Number"
          },
          "contract_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Address"
          },
          "mode": {
            "enum": [
              "evm",
              "fixture"
            ],
            "title": "Mode",
            "type": "string"
          },
          "network": {
            "title": "Network",
            "type": "string"
          },
          "tx_hash": {
            "anyOf": [
              {
                "pattern": "^0x[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tx Hash"
          }
        },
        "required": [
          "tx_hash",
          "block_number",
          "contract_address",
          "network",
          "mode"
        ],
        "title": "ChainReceipt",
        "type": "object"
      },
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 64,
              "pattern": "^[a-z]+:[0-9]+$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[a-z]+:[0-9]+$",
            "title": "Id",
            "type": "string"
          },
          "text": {
            "maxLength": 700,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "evidence_ids"
        ],
        "title": "Claim",
        "type": "object"
      },
      "CoverageMap": {
        "additionalProperties": false,
        "properties": {
          "redirects": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Redirects",
            "type": "string"
          },
          "threat_intel": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Threat Intel",
            "type": "string"
          },
          "tls": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Tls",
            "type": "string"
          },
          "url": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "tls",
          "threat_intel",
          "redirects"
        ],
        "title": "CoverageMap",
        "type": "object"
      },
      "EvidenceBundle-Input": {
        "additionalProperties": false,
        "properties": {
          "ai_claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "maxItems": 30,
            "title": "Ai Claims",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageMap"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "discriminator": {
                "mapping": {
                  "message_span": "#/components/schemas/MessageSpanEvidence",
                  "redirect": "#/components/schemas/RedirectEvidence",
                  "threat_intel": "#/components/schemas/ThreatEvidence",
                  "tls": "#/components/schemas/TLSEvidence",
                  "url": "#/components/schemas/URLEvidence"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/URLEvidence"
                },
                {
                  "$ref": "#/components/schemas/TLSEvidence"
                },
                {
                  "$ref": "#/components/schemas/ThreatEvidence"
                },
                {
                  "$ref": "#/components/schemas/RedirectEvidence"
                },
                {
                  "$ref": "#/components/schemas/MessageSpanEvidence"
                }
              ]
            },
            "maxItems": 100,
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "title": "Limitations",
            "type": "array"
          },
          "normalized_url": {
            "title": "Normalized Url",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "report_id": {
            "title": "Report Id",
            "type": "string"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskClass"
          },
          "schema": {
            "const": "sealed-evidence/1",
            "default": "sealed-evidence/1",
            "title": "Schema",
            "type": "string"
          },
          "social_engineering_indicators": {
            "items": {
              "$ref": "#/components/schemas/SocialIndicator"
            },
            "maxItems": 30,
            "title": "Social Engineering Indicators",
            "type": "array"
          }
        },
        "required": [
          "report_id",
          "created_at",
          "normalized_url",
          "risk",
          "evidence",
          "ai_claims",
          "coverage",
          "provenance"
        ],
        "title": "EvidenceBundle",
        "type": "object"
      },
      "EvidenceBundle-Output": {
        "additionalProperties": false,
        "properties": {
          "ai_claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "maxItems": 30,
            "title": "Ai Claims",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageMap"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "discriminator": {
                "mapping": {
                  "message_span": "#/components/schemas/MessageSpanEvidence",
                  "redirect": "#/components/schemas/RedirectEvidence",
                  "threat_intel": "#/components/schemas/ThreatEvidence",
                  "tls": "#/components/schemas/TLSEvidence",
                  "url": "#/components/schemas/URLEvidence"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/URLEvidence"
                },
                {
                  "$ref": "#/components/schemas/TLSEvidence"
                },
                {
                  "$ref": "#/components/schemas/ThreatEvidence"
                },
                {
                  "$ref": "#/components/schemas/RedirectEvidence"
                },
                {
                  "$ref": "#/components/schemas/MessageSpanEvidence"
                }
              ]
            },
            "maxItems": 100,
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "title": "Limitations",
            "type": "array"
          },
          "normalized_url": {
            "title": "Normalized Url",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "report_id": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Report Id",
            "type": "string"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskClass"
          },
          "schema": {
            "const": "sealed-evidence/1",
            "default": "sealed-evidence/1",
            "title": "Schema",
            "type": "string"
          },
          "social_engineering_indicators": {
            "items": {
              "$ref": "#/components/schemas/SocialIndicator"
            },
            "maxItems": 30,
            "title": "Social Engineering Indicators",
            "type": "array"
          }
        },
        "required": [
          "report_id",
          "created_at",
          "normalized_url",
          "risk",
          "evidence",
          "ai_claims",
          "coverage",
          "provenance"
        ],
        "title": "EvidenceBundle",
        "type": "object"
      },
      "FixtureMetadata": {
        "additionalProperties": false,
        "properties": {
          "expected_risk": {
            "$ref": "#/components/schemas/RiskClass"
          },
          "fixture_id": {
            "title": "Fixture Id",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/InvestigateRequest"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "fixture_id",
          "title",
          "expected_risk",
          "input"
        ],
        "title": "FixtureMetadata",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "chain_connected": {
            "title": "Chain Connected",
            "type": "boolean"
          },
          "chain_mode": {
            "enum": [
              "evm",
              "fixture"
            ],
            "title": "Chain Mode",
            "type": "string"
          },
          "contract_address": {
            "title": "Contract Address",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "chain_connected",
          "contract_address",
          "chain_mode"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InvestigateRequest": {
        "additionalProperties": false,
        "properties": {
          "fixture_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Id"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 12000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "url": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "InvestigateRequest",
        "type": "object"
      },
      "InvestigationReport": {
        "additionalProperties": false,
        "properties": {
          "bundle": {
            "$ref": "#/components/schemas/EvidenceBundle-Output"
          },
          "chain_receipt": {
            "$ref": "#/components/schemas/ChainReceipt"
          },
          "merkle": {
            "$ref": "#/components/schemas/MerkleReport"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationResponse"
          }
        },
        "required": [
          "bundle",
          "merkle",
          "chain_receipt",
          "verification"
        ],
        "title": "InvestigationReport",
        "type": "object"
      },
      "MerkleLeaf": {
        "additionalProperties": false,
        "properties": {
          "hash": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Hash",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "payload",
          "hash"
        ],
        "title": "MerkleLeaf",
        "type": "object"
      },
      "MerkleReport": {
        "additionalProperties": false,
        "properties": {
          "leaves": {
            "items": {
              "$ref": "#/components/schemas/MerkleLeaf"
            },
            "title": "Leaves",
            "type": "array"
          },
          "proofs_by_id": {
            "additionalProperties": {
              "items": {
                "pattern": "^0x[0-9a-f]{64}$",
                "type": "string"
              },
              "type": "array"
            },
            "title": "Proofs By Id",
            "type": "object"
          },
          "root": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Root",
            "type": "string"
          }
        },
        "required": [
          "root",
          "leaves",
          "proofs_by_id"
        ],
        "title": "MerkleReport",
        "type": "object"
      },
      "MessageData": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "pattern_type": {
            "enum": [
              "urgency",
              "credential_harvesting",
              "otp_request",
              "seed_phrase_request",
              "payment_lure",
              "brand_impersonation"
            ],
            "title": "Pattern Type",
            "type": "string"
          },
          "redacted_excerpt": {
            "maxLength": 600,
            "title": "Redacted Excerpt",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end",
          "pattern_type",
          "sha256",
          "redacted_excerpt"
        ],
        "title": "MessageData",
        "type": "object"
      },
      "MessageSpanEvidence": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MessageData"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[a-z]+:[0-9]+$",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "fixture",
              "live",
              "local"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "TIMEOUT",
              "FAILED",
              "UNCONFIGURED"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "const": "message_span",
            "default": "message_span",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "mode",
          "data"
        ],
        "title": "MessageSpanEvidence",
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "properties": {
          "analyzer": {
            "enum": [
              "fixture",
              "deterministic",
              "openai"
            ],
            "title": "Analyzer",
            "type": "string"
          },
          "collection": {
            "enum": [
              "fixture",
              "live",
              "local"
            ],
            "title": "Collection",
            "type": "string"
          },
          "fixture_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Id"
          }
        },
        "required": [
          "collection",
          "analyzer"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "RedirectData": {
        "additionalProperties": false,
        "properties": {
          "chain": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Chain",
            "type": "array"
          },
          "cross_domain_hops": {
            "default": 0,
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Cross Domain Hops",
            "type": "integer"
          },
          "limit_reached": {
            "default": false,
            "title": "Limit Reached",
            "type": "boolean"
          },
          "loop_detected": {
            "default": false,
            "title": "Loop Detected",
            "type": "boolean"
          },
          "ssrf_blocked": {
            "default": false,
            "title": "Ssrf Blocked",
            "type": "boolean"
          },
          "untrusted_destination": {
            "default": false,
            "title": "Untrusted Destination",
            "type": "boolean"
          }
        },
        "required": [
          "chain"
        ],
        "title": "RedirectData",
        "type": "object"
      },
      "RedirectEvidence": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RedirectData"
          },
