            "type": "string"
          },
          "expected_root": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "Expected Root",
            "type": "string"
          },
          "mutated_bundle": {
            "$ref": "#/components/schemas/EvidenceBundle-Output"
