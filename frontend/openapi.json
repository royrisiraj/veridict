          "evidence_ids": {
            "items": {
              "maxLength": 64,
              "pattern": "^[a-z]+:[0-9]+$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "type": {
            "maxLength": 80,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "evidence_ids"
        ],
        "title": "SocialIndicator",
        "type": "object"
      },
      "TLSData": {
