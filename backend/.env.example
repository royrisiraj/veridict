# Recommended Vercel fixture preview: no external keys, RPC, database or signer.
RUNTIME_MODE=serverless
CHAIN_MODE=demo_fixture
LIVE_CHECKS=false
CORS_ORIGINS=https://your-veridict.vercel.app
# Native live/public-chain options; not used by the serverless fixture preview.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_SAFE_BROWSING_KEY=
OPENPHISH_CACHE_PATH=
OPENPHISH_CACHE_MAX_AGE=86400
RPC_URL=
CONTRACT_ADDRESS=
CHAIN_ID=
CHAIN_PRIVATE_KEY=

# Phase 2: connect a PRIVATE Blob store to the backend project, then explicitly
# set REPORT_STORAGE=vercel_blob. The SDK uses OIDC+BLOB_STORE_ID when available,
# otherwise a server-side read/write token. No credentials are needed for fixtures.
REPORT_STORAGE=packaged
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# LIVE_CHECKS=true also requires these controls and available durable storage.
SCAN_API_SECRET=
SCAN_ALLOWED_HOSTS=example.com,www.wikipedia.org
SCAN_HOURLY_LIMIT=20
SCAN_CLIENT_LIMIT=5
# Sepolia reads: CHAIN_MODE=public_chain, CHAIN_ID=11155111, HTTPS RPC_URL,
# CONTRACT_ADDRESS=<actual deployed EvidenceRegistry>. No signer needed for reads.
# Registration stays OFF unless separately authorized and protected.
ANCHOR_ENABLED=false
ANCHOR_API_SECRET=
ANCHOR_DAILY_LIMIT=6
ANCHOR_MAX_FEE_GWEI=20
ANCHOR_MAX_GAS=150000
